  "assumptions": [
    {
      "name": "cohort upload rate and RTT",
      "value": {
        "slow": {
          "rate_mbps": 7.0,
          "rtt_ms": 40.0
        },
        "medium": {
          "rate_mbps": 20.0,
          "rtt_ms": 25.0
        },
        "fast": {
          "rate_mbps": 54.0,
          "rtt_ms": 10.0
        }
      },
      "reason": "Taken from published Indian measurements (docs/network-profiles.md); the k6 VMs are shaped to the same values, so the model and the run see the same links. One rate per cohort, no spread inside it, because the shaper gives every student in a cohort the same link."
    },
    {
      "name": "cohort weights",
      "value": "slow 0.3, medium 0.4, fast 0.3",
      "reason": "No public source gives the network mix of students at a deadline. These are the weights the dry runs already used (tools/gen_schedule.py DEFAULT_COHORTS), kept so the dry runs and the counted runs replay the same mix; most weight sits on the two mobile-like cohorts."
    },
    {
      "name": "file-size mix",
      "value": "1 MiB 10%, 2 MiB 20%, 5 MiB 30%, 10 MiB 20%, 15 MiB 15%, 25 MiB 5%",
      "reason": "The schedule's size buckets (tools/gen_schedule.py) and the files make-files.sh writes (1 MiB = 1,048,576 bytes). No public source gives assignment file sizes; the mix centres on 5 MiB (a report with images) with a 25 MiB tail under the 25 MB cap."
    },
    {
      "name": "hash time",
      "value": "size / 80 MiB/s",
      "reason": "Web Crypto SHA-256 in a mid-range phone browser; the k6 script sleeps exactly this long before the arm C commit, so the model matches what the run does."
    },
    {
      "name": "click-time curve",
      "value": "convex: P(t < x) = 1 - (1 - x/W)^beta, W = 600 s, beta = 4.8484; 40% of the cohort in the final 60 s",
      "reason": "No pilot curve exists (D8). This is the curve tools/gen_schedule.py already draws from, so the model predicts the schedule the runs replay."
    },
    {
      "name": "N (cohort window, minutes)",
      "value": 10,
      "reason": "0 pilot submissions (< 30), so N = 10"
    },
    {
      "name": "share of a course in the final N minutes",
      "value": 0.3333333333333333,
      "reason": "No whole-course arrival curve exists. One third is the share the pre-registered N rule aims for (the smallest window holding at least a third of submissions). The count scales linearly: count = 1,000 x share x P(on time and misjudged)."
    },
    {
      "name": "submissions before the final N minutes are never misjudged",
      "value": "longest arm B threshold at 0.5x speed = 60.0 s < 600 s",
      "reason": "Checked at startup: a click earlier than N minutes leaves more time than the slowest transfer needs."
    },
    {
      "name": "what the rules leave out",
      "value": "TCP slow start, header overhead, retries, queueing, cold starts, Cloud Run buffering",
      "reason": "The model is the no-load floor. Measured arm A minus the model is the load-induced error."
    },
    {
      "name": "speed multiplier stands in for the click-curve test",
      "value": "0.5x and 2x",
      "reason": "Stretching every click offset by a is the same as multiplying every rate by a with RTT divided by a (c*a < 8S/U + r  <=>  c < 8S/(aU) + r/a); RTT is small next to transfer time, so the speed range also covers D8's 0.5x / 2x click-curve test."
    }
  ],
