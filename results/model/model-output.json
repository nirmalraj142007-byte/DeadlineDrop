  "pilot": null,
  "N_minutes": 10,
  "N_rule": "N = smallest whole number of minutes before the deadline containing at least one third of all pilot submissions, clamped to 5-15; if fewer than 30 submissions exist, N = 10.",
  "N_reason": "0 pilot submissions (< 30), so N = 10",
  "rules": {
    "late_A": "c < 8*S/U + r",
    "late_B": "c < 8*S/U + 3*r",
    "late_C": "c < h + r",
    "on_time": "c >= 5 s; [0, 5) s reported as margin"
  },
  "seed": 20261119,
  "samples": 10000,
  "run_of_1000_definition": "1000 students, 10% late (excluded), the rest on the click curve; rate = misjudged / truly on time; spread over 10000 simulated runs",
