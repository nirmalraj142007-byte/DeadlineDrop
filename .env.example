# Copy this file to .env and fill in the values before running docker compose.
# .env is git-ignored — never commit real secrets.

DB_USER=dd
DB_PASSWORD=change-me-local
# Generate with: openssl rand -base64 48
JWT_SECRET=
SEED_PASSWORD=change-me-seed
DD_STORAGE_HMAC_SECRET=change-me-storage-hmac-secret-32-bytes
# Sent by the local scheduler container to /internal/** (header X-Internal-Token).
# At least 32 characters. Generate with: openssl rand -base64 32
INTERNAL_TOKEN=
