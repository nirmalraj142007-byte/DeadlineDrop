# Connection budget after evidence collection: 3 arms x 1 instance x pool 5 = 15 <= 25 - 5
# on db-f1-micro. This leaves ten connections below the PostgreSQL max_connections ceiling.
CPU=1
MEMORY=1Gi
CONCURRENCY=80
MAX_INSTANCES=1
MIN_INSTANCES=0
DB_POOL_MAX=5
TIMEOUT=300

# SWEEP block (phase 32): settings for the counted sweeps, applied by `bash tools/sweep-mode.sh on`
# and removed by `... off`. Same values on every arm, so parity holds in both modes.
# One warm instance per arm removes cold starts (results/coldstart.json: median 14.8 s) from the
# first click of every run; startup CPU boost shortens the scale-out to instances 2 and 3.
SWEEP_MIN_INSTANCES=1
SWEEP_CPU_BOOST=on
