# Network shaping per cohort (read by tools/vm/shape.sh and tools/vm/sanity.sh).
# Values from docs/network-profiles.md (Ookla open data, India, 2026 Q3; D8: no pilot).
# DELAY is added by netem on egress only, so it is the cohort's whole added round trip.
# LOSS keeps the Mathis limit above the rate (docs/network-profiles.md, "Cohorts").
SLOW_RATE=7mbit
SLOW_DELAY=40ms
SLOW_LOSS=0.1%
MEDIUM_RATE=20mbit
MEDIUM_DELAY=25ms
MEDIUM_LOSS=0.05%
FAST_RATE=54mbit
FAST_DELAY=10ms
FAST_LOSS=0.01%
